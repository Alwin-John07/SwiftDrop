<Window x:Class="SwiftDropDesktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SwiftDrop"
        Height="800"
        Width="950"
        MinHeight="700"
        MinWidth="850"
        WindowStartupLocation="CenterScreen"
        Background="#F5F7FA">

    <Grid Margin="20">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="20"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="20"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="20"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="20"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0">
            <TextBlock Text="SwiftDrop"
                       FontSize="34"
                       FontWeight="Bold"/>
            <TextBlock Text="Fast Local File Sharing"
                       FontSize="15"
                       Foreground="Gray"/>
        </StackPanel>

        <!-- Receiver -->
        <Border Grid.Row="2"
                Background="White"
                CornerRadius="12"
                Padding="20">

            <StackPanel>

                <TextBlock Text="Receiver"
                           FontSize="20"
                           FontWeight="Bold"/>

                <TextBlock x:Name="StatusTitle"
                           Margin="0,18,0,0"
                           FontSize="20"
                           FontWeight="SemiBold"
                           Foreground="Green"
                           Text="🟢 Ready"/>

                <Grid Margin="0,20,0,0">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="170"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Grid.RowDefinitions>
                        <RowDefinition/>
                        <RowDefinition/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                               FontWeight="Bold"
                               Text="Status:"/>

                    <TextBlock x:Name="StatusMessage"
                               Grid.Row="0"
                               Grid.Column="1"
                               Text="Waiting for Android device..."/>

                    <TextBlock Grid.Row="1"
                               Grid.Column="0"
                               Margin="0,12,0,0"
                               FontWeight="Bold"
                               Text="Connected Device:"/>

                    <TextBlock x:Name="DeviceName"
                               Grid.Row="1"
                               Grid.Column="1"
                               Margin="0,12,0,0"
                               Text="Android Device"/>

                </Grid>

            </StackPanel>

        </Border>

        <!-- Available Devices / Send Files -->
<Border Grid.Row="4"
        Background="White"
        CornerRadius="12"
        Padding="20">

    <Grid>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="130"/>
            <RowDefinition Height="15"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="15"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock
            Grid.Row="0"
            Text="Available Devices"
            FontSize="20"
            FontWeight="Bold"/>

        <ListBox
            x:Name="DeviceList"
            Grid.Row="1"
            Margin="0,15,0,0"
            DisplayMemberPath="DisplayName"/>

        <Grid Grid.Row="3">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="130"/>
            </Grid.ColumnDefinitions>

            <TextBlock
                x:Name="SelectedFileText"
                VerticalAlignment="Center"
                FontSize="14"
                Text="No file selected"
                TextTrimming="CharacterEllipsis"/>

            <Button
                x:Name="BrowseButton"
                Grid.Column="1"
                Width="120"
                Height="34"
                Content="Browse..." />

        </Grid>

        <Button
            x:Name="SendButton"
            Grid.Row="5"
            Width="140"
            Height="40"
            HorizontalAlignment="Right"
            Content="Send File"/>

    </Grid>

</Border>

        <!-- Transfer -->
        <Border Grid.Row="6"
                Background="White"
                CornerRadius="12"
                Padding="20">

            <Grid>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="25"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                           Text="Current Transfer"
                           FontSize="20"
                           FontWeight="Bold"/>

                <Separator Grid.Row="1"
                           Margin="0,12"/>

                <StackPanel Grid.Row="2">

                    <TextBlock x:Name="CurrentFile"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Text="No transfers yet"/>

                    <TextBlock x:Name="TransferInfo"
                               Margin="0,8,0,0"
                               FontSize="15"
                               Foreground="Gray"
                               Text="Waiting for incoming files"/>

                    <ProgressBar x:Name="TransferProgress"
                                 Margin="0,20,0,0"
                                 Height="20"
                                 Minimum="0"
                                 Maximum="100"/>

                </StackPanel>

                <TextBlock Grid.Row="4"
                           Margin="0,5,0,10"
                           Text="Recent Transfers"
                           FontSize="18"
                           FontWeight="Bold"/>

                <Border Grid.Row="5"
                        BorderBrush="#DDDDDD"
                        BorderThickness="1"
                        CornerRadius="8">

                    <ListView x:Name="TransferHistoryList"
                              BorderThickness="0"
                              Background="Transparent"
                              MouseDoubleClick="TransferHistoryList_MouseDoubleClick"
                              PreviewMouseRightButtonDown="TransferHistoryList_PreviewMouseRightButtonDown">

                        <ListView.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="📂 Open"
                                          Click="OpenMenuItem_Click"/>
                                <MenuItem Header="📁 Open Containing Folder"
                                          Click="OpenFolderMenuItem_Click"/>
                                <Separator/>
                                <MenuItem Header="📋 Copy Full Path"
                                          Click="CopyPathMenuItem_Click"/>
                                <Separator/>
                                <MenuItem Header="🗑 Remove From History"
                                          Click="RemoveHistoryMenuItem_Click"/>
                                <Separator/>
                                <MenuItem Header="🧹 Clear History"
                                          Click="ClearHistoryMenuItem_Click"/>
                            </ContextMenu>
                        </ListView.ContextMenu>

                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="" Width="45"
                                                DisplayMemberBinding="{Binding Icon}"/>
                                <GridViewColumn Header="File"
                                                Width="330"
                                                DisplayMemberBinding="{Binding FileName}"/>
                                <GridViewColumn Header="Size"
                                                Width="120"
                                                DisplayMemberBinding="{Binding FileSize}"/>
                                <GridViewColumn Header="Received"
                                                Width="150"
                                                DisplayMemberBinding="{Binding ReceivedAt}"/>
                            </GridView>
                        </ListView.View>

                    </ListView>

                </Border>

            </Grid>

        </Border>

        <!-- Bottom -->
        <StackPanel Grid.Row="8"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">

            <Button x:Name="OpenFolderButton"
                    Width="210"
                    Height="44"
                    FontSize="15"
                    Content="Open Received Folder"/>

        </StackPanel>

    </Grid>

</Window>
